# Copy to .env for local development. Never commit the real file.

# Port the Node server listens on. Render sets PORT for you.
PORT=8787

# SQLite directory. Created on boot. On Render's free web service the disk
# is ephemeral: a restart or redeploy can wipe it. See README.
DATA_DIR=./data

# API key from https://physiology.presagetech.com — required for a live camera
# check-in. Leave blank to run the sample house and the sample check-in only.
SMARTSPECTRA_API_KEY=

# Session summaries and device-readiness reports to Presage. Leave false.
# Authentication of the API key still happens when a live check-in starts.
# See README "Consent and Data Handling".
SMARTSPECTRA_TELEMETRY=false

# Seed the Maple / 2468 sample house when it is not already in the database.
SEED_DEMO=true

# pino level: debug | info | warn | error
LOG_LEVEL=info

# How long the HTTP process waits for the SDK process to start, in milliseconds.
# If Presage or the native library does not answer, that process is killed and
# the sample house keeps working.
SMARTSPECTRA_STARTUP_TIMEOUT_MS=20000
